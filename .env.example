# GrammarGolf environment — copy to .env and fill in.
#
# This file lives at the REPO ROOT, outside the web root (www/), so .env is
# never reachable over HTTP. loadEnv.php reads it and exports the values.
# .env itself is gitignored — never commit real secrets.

# --- LTI (Brightspace grade passback) ---------------------------------------
# Shared key/secret configured on the Brightspace side; postLTI.php signs the
# outgoing grade message with them.
LTI_KEY="anythingKey"
LTI_SECRET="anythingSecret"

# --- Admin roster ------------------------------------------------------------
# Comma-separated netIDs allowed into /admin/ (the course editor) and allowed
# to overwrite the shared master problem sets. Empty or unset = nobody is an
# admin (fail closed).
GRAMMARGOLF_ADMINS=""
