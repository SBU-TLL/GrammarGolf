# Keep the production image clean and free of dev/VCS/secret material.

# Version control & this build's own files
.git
.gitignore
.dockerignore
Dockerfile

# Local DDEV development environment (dev-only; never deployed)
.ddev/
.vscode/

# Local env / secrets — production uses runtime env vars, not files
.env
.env.*

# Committed PHP session files (dev artifacts; must not ship)
sess_*
**/sess_*

# Dev/build scripts, notes, and sample course text not needed at runtime
*.py
*.md
*.txt
README*
package.json
package-lock.json
node_modules/

# OS / editor junk (Finder metadata, AppleDouble resource forks, swap files)
.DS_Store
**/.DS_Store
._*
**/._*
Thumbs.db
*.swp
*.swo
