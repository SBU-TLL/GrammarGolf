# GrammarGolf environment — copy to .env and fill in.
#
# This file lives at the REPO ROOT, outside the web root (www/), so .env is
# never reachable over HTTP. loadEnv.php reads it and exports the values.
# .env itself is gitignored — never commit real secrets.

# --- LTI (Brightspace grade passback) ---------------------------------------
# Shared key/secret configured on the Brightspace side; postLTI.php signs the
# outgoing grade message with them.
LTI_KEY="anythingKey"
LTI_SECRET="anythingSecret"

# --- Shibboleth --------------------------------------------------------------
# Where a login starts. Leave BOTH unset for local development: the DDEV add-on
# runs an SP on this same host, so the default relative "/Shibboleth.sso" works.
#
# Production uses a CENTRAL SP: one entityID (auth.tll.stonybrook.edu) owns the
# only AssertionConsumerService registered with the university IdP, and session
# cookies are scoped to .tll.stonybrook.edu so every *.tll app shares the
# session. Point SHIB_HANDLER_URL at that handler, and set GRAMMARGOLF_BASE_URL
# so the post-login target comes back here (it must be absolute, and must not be
# taken from the client-supplied Host header):
#
#   SHIB_HANDLER_URL="https://auth.tll.stonybrook.edu/Shibboleth.sso"
#   GRAMMARGOLF_BASE_URL="https://grammargolf.tll.stonybrook.edu"
# The SP must also export attributes as environment variables, i.e. WITHOUT
# "ShibUseHeaders On" — the app deliberately ignores request headers, since
# mod_shib strips client-supplied copies of them only on paths it handles.
SHIB_HANDLER_URL=""
GRAMMARGOLF_BASE_URL=""

# --- Admin roster ------------------------------------------------------------
# Comma-separated netIDs allowed into /admin/ (the course editor) and allowed
# to overwrite the shared master problem sets. Empty or unset = nobody is an
# admin (fail closed).
GRAMMARGOLF_ADMINS=""
