###############################################################################
# GrammarGolf — production environment template
#
# Copy to your runtime secret store / Azure container env (do NOT commit a real
# .env). Values here are PLACEHOLDERS. GrammarGolf has NO database and NO
# application secrets of its own; this template documents the platform/auth
# contract and the one external dependency.
#
# Nothing here is baked into the image; the container reads these at runtime.
# The repo's DEV .ddev/.env (mock identity) is NOT used in production and is
# excluded from the image (.dockerignore).
###############################################################################

# --- Environment flag --------------------------------------------------------
APP_ENV=production
TZ=America/New_York

# --- Ingress / routing -------------------------------------------------------
PUBLIC_HOSTNAME=grammargolf.<your-subdomain>.stonybrook.edu
# Apache listens on 8080 inside the container (non-root); ingress forwards
# 443 -> 8080. DocumentRoot is ./public.
APACHE_LISTEN_PORT=8080

# --- Authentication (LTI launch + Shibboleth at the ingress) -----------------
# The app is entered either by an LTI launch (LMS POSTs lis_person_* into the
# PHP session) or via Shibboleth ($_SERVER attributes), enforced at the ingress
# / reverse proxy (Ansible-managed). No SSO secrets are stored in this container.
# (A dev identity shim in auth.php/index.php keys on the hostname containing
# "ddev" and is inert in production.)

# --- EXTERNAL internal-project dependency: the "lti" project ------------------
# Grade passback (public/grading.js) POSTs to /LTI/postLTI.php — the separate
# internal "lti" app, NOT bundled in this image. In production it MUST be served
# at the same origin as this app (deploy the lti container there, or route
# /LTI/* to it via the ingress) or grade submission will 404.
LTI_ENDPOINT_PATH=/LTI/postLTI.php

# --- Database ----------------------------------------------------------------
# NONE. Per-user progress is written to JSON under /var/www/html/data (OUTSIDE
# the web root). Mount a persistent volume there so progress survives redeploys:
#   docker run -v grammargolf-data:/var/www/html/data ...

# --- Application secrets -----------------------------------------------------
# NONE.
